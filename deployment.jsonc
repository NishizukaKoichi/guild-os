{
  // Cloudflare account that owns every Worker and provisioned resource.
  // Find it: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "<CLOUDFLARE_ACCOUNT_ID>",

  // Worker names are permanent service identities. Keep them unique within the account.
  // Reference: docs/customization.md#workers-and-routing
  "workers": {
    "workshop": {
      "name": "<WORKSHOP_WORKER_NAME>",

      // Production: use a hostname in an active Cloudflare zone. Wrangler creates DNS and TLS.
      // Evaluation: replace this with "route": { "workersDev": true }.
      // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
      "route": { "customDomain": "os.example.com" }
    },
    "context": { "name": "<CONTEXT_WORKER_NAME>" },
    "guildGatekeeper": { "name": "<GUILD_GATEKEEPER_WORKER_NAME>" },
    "webhookReceiver": {
      "name": "<WEBHOOK_RECEIVER_WORKER_NAME>",
      "route": { "customDomain": "hooks.example.com" }
    },
    "errorReporter": { "name": "<ERROR_REPORTER_WORKER_NAME>" }
  },

  // This starter deploys Cloudflare Access mode. Cloudflare OS also supports built-in password
  // accounts and auth Gatekeeper sign-in; see the reference below before switching. The audience
  // comes from the self-hosted Access application protecting the Workshop hostname.
  // "admins" gates /admin in every sign-in method.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://<TEAM_NAME>.cloudflareaccess.com",
    "audience": "<ACCESS_AUDIENCE>",
    "admins": ["<ADMIN_EMAIL>"]
  },

  // Optional platform-funded model catalog. Leave disabled to deploy without AI setup.
  // When enabled, replace every placeholder and install CF_AI_GATEWAY_API_TOKEN separately.
  // Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": false,
    "name": "<AI_GATEWAY_NAME>",
    "accountId": "<AI_GATEWAY_ACCOUNT_ID>",
    "providers": ["anthropic", "openai", "google", "cloudflare"],

    // "direct" sends Workers AI to its REST endpoint. "gateway" adds AI Gateway logs.
    "workersAi": { "mode": "gateway", "gateway": "<WORKERS_AI_GATEWAY_NAME>" }
  },

  "context": {
    // Isolates Context data shared by this Workshop deployment.
    "sharingDomain": "production",

    // null: Wrangler provisions and remembers a KV namespace on first deploy.
    // string: bind an existing namespace by ID.
    "kvNamespaceId": null

    // Optional Git-compatible storage for Context collections. To enable it, add a comma after
    // kvNamespaceId and uncomment this object. Requires Artifacts account access.
    // "artifacts": {
    //   "enabled": true,
    //   // Optional override; defaults to "gatekeeper-context-collections".
    //   "namespace": "custom-context-collections"
    // }
  },

  // One deployment is one Guild. IDs remain stable across deploys and migrations.
  // Hyperdrive owns the database credentials; only its non-secret configuration ID is tracked.
  "guild": {
    "id": "<GUILD_UUID>",
    "name": "<GUILD_NAME>",
    "purpose": "<GUILD_PURPOSE>",
    "rootSpaceName": "Guild",
    "level2ApprovalQuorum": 1,
    "level3ApprovalQuorum": 1,
    "dataRetentionDays": 2555,
    "hyperdriveId": "<HYPERDRIVE_ID>",

    // Ask Guild uses the Worker AI binding. The default gateway is created on first use.
    "askModel": "@cf/meta/llama-3.1-8b-instruct-fast",
    "aiGatewayId": "default",
    "askRequestsPerMinute": 20,
    "recoveryAttemptsPerMinute": 5,

    // The only v1 external write target. Runtime callers cannot replace this URL.
    // Supply GUILD_WEBHOOK_SIGNING_SECRET to `pnpm deploy`; never store it in this file.
    "agentWorkflowName": "<AGENT_WORKFLOW_NAME>",
    "webhook": {
      "connectorId": "<WEBHOOK_CONNECTOR_UUID>",
      "name": "Approved operations webhook",
      "url": "https://hooks.example.com/guild-events"
    }
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  // Set release to a commit/version when your deployment pipeline has one.
  // Reference: docs/observability.md#quick-start
  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // Optional reference receiver for the v1 Agent write. It uses a SQLite-backed Durable Object
  // for strongly consistent idempotency. Disable it when guild.webhook.url points to another
  // purchaser-owned implementation of docs/agent-webhook.md.
  "referenceWebhook": {
    "enabled": true
  },

  // null values use Wrangler automatic provisioning. Set IDs/names to reuse owned resources.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  "resources": {
    "blueprintsKvNamespaceId": null,
    "avatarsKvNamespaceId": null,
    "blueprintContentBucket": null,
    "knowledgeFilesBucket": null
  },

  // Structured custom logs stay enabled. Invocation logs and traces are separate volume controls.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
