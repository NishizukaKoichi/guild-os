{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "guild-gatekeeper",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["GuildGatekeeper"]
    }
  ],
  "vars": {
    "GUILD_ID": "018f1f3e-7b5a-7d40-8f43-4fe1dc555a9a",
    "GUILD_NAME": "Example Guild",
    "GUILD_PURPOSE": "Coordinate people and agents around shared memory and governed work.",
    "GUILD_ROOT_SPACE_NAME": "Guild",
    "GUILD_LEVEL2_QUORUM": "1",
    "GUILD_LEVEL3_QUORUM": "1",
    "GUILD_RETENTION_DAYS": "2555",
    "GUILD_ASK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "GUILD_AI_GATEWAY_ID": "default"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE_FILES",
      "bucket_name": "guild-os-knowledge-files"
    }
  ],
  "ratelimits": [
    {
      "name": "ASK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
