{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "guild-os-webhook-receiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "WEBHOOK_RECEIPTS", "class_name": "WebhookReceipt" }
    ]
  },
  "exports": {
    "WebhookReceipt": { "type": "durable-object", "storage": "sqlite" }
  },
  "secrets": {
    "required": ["GUILD_WEBHOOK_SIGNING_SECRET"]
  }
}
