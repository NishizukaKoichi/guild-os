{
  "name": "@guild-os/postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node scripts/migrate.mjs",
    "test:integration": "node scripts/integration.mjs && vitest run src/actor-authorization.integration.test.ts",
    "types:check": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs && vitest run"
  },
  "dependencies": {
    "@guild-os/domain": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
